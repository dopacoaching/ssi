generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      Role     @default(TEACHER)
  batchIds  String[] @db.ObjectId
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  remarks   Remark[]
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Batch {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String          @unique
  year      Int
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  students  Student[]
  approvals BatchApproval[]
}

model BatchApproval {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  batchId   String   @db.ObjectId
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, month, year])
}

model Student {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  regNumber    String        @unique
  password     String?
  photo        String?
  batchId      String        @db.ObjectId
  batch        Batch         @relation(fields: [batchId], references: [id])
  role         Role          @default(STUDENT)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ceRecords    CERecord[]
  weeklyTests  WeeklyTest[]
  monthlyTests MonthlyTest[]
  remarks      Remark[]
}

model CERecord {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String      @db.ObjectId
  student         Student     @relation(fields: [studentId], references: [id])
  month           Int
  year            Int
  physicsMarks    Float
  physicsMax      Float       @default(100)
  chemMarks       Float
  chemMax         Float       @default(100)
  mathMarks       Float
  mathMax         Float       @default(100)
  bioMarks        Float
  bioMax          Float       @default(100)
  lang1Marks      Float
  lang1Max        Float       @default(100)
  lang2Marks      Float
  lang2Max        Float       @default(100)
  psychologyMarks Float       @default(0)
  psychologyMax   Float       @default(100)
  mcqMarks        Float       @default(0)
  mcqMax          Float       @default(100)
  mcqPct          Float
  attendancePct   Float
  hasMedCert      Boolean     @default(false)
  notesStatus     NotesStatus
  theoryScore     Float
  mcqScore        Float
  attendScore     Float
  notesScore      Float
  totalCE         Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum NotesStatus {
  COMPLETE
  PARTIAL
  INCOMPLETE
}

model WeeklyTest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id])
  weekDate  DateTime
  testType  String   @default("Theory")
  subject   String
  chapter   String   @default("")
  marks     Float
  maxMarks  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyTest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id])
  month     Int
  year      Int
  testType  String   @default("Theory")
  subject   String
  marks     Float
  maxMarks  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Remark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId String   @db.ObjectId
  teacher   User     @relation(fields: [teacherId], references: [id])
  category  String
  text      String
  isFlagged Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  userName    String?
  userRole    String?
  action      String
  entity      String
  entityId    String
  description String
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}
